{
  "permissions": {
    "allow": [
      "Bash(./gradlew :server:test)",
      "Bash(./gradlew :app:shared:desktopTest)",
      "Bash(./gradlew :server:run)",
      "Bash(./gradlew ktlintCheck)",
      "Bash(./gradlew ktlintFormat)"
    ],
    "ask": [
      "Bash(git push*)"
    ],
    "deny": [
      "Read(**/build/**)",
      "Read(.gradle/**)",
      "Read(local.properties)",
      "Read(secrets.properties)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Bash(gcloud run deploy --source=*)",
      "Bash(gcloud run jobs deploy --source=*)",
      "Bash(gcloud builds submit*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/ktlint-format.sh"
          }
        ]
      }
    ]
  }
}
